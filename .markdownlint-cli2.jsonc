{
  "config": {
    "default": true,

    // Enforce readable prose line-length; ignore fenced code and tables.
    // Note: long unbreakable tokens (e.g., URLs) are tolerated by default (strict: false).
    "MD013": { "line_length": 80, "code_blocks": false, "tables": false }
  },

  "globs": [
    "**/*.md",
    "!vendor/**",
    "!node_modules/**",
    "!.git/**"
  ]
}
