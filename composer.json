{
    "name": "andrewmy/gallinor",
    "description": "Gallinor — Gallery Minor — reducing your gallery size while maintaining quality.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "monolog/monolog": "^3.9",
        "psr/log": "^3.0",
        "symfony/console": "^7.3",
        "symfony/filesystem": "^8.0",
        "symfony/process": "^8.0"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0",
        "mikey179/vfsstream": "^1.6",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5.8",
        "rector/rector": "^2.2",
        "roave/security-advisories": "dev-latest",
        "rregeer/phpunit-coverage-check": "^0.3.1",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
          "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "authors": [
      {
        "name": "Andrejs M-J",
        "email": "andrejs@gmail.com"
      }
    ]
}
